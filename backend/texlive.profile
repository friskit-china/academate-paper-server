# Install every TeX Live package while omitting documentation and package source.
# The installer chooses the matching Linux binary collection for the build platform.
selected_scheme scheme-full
TEXDIR /opt/texlive/2025
TEXMFLOCAL /opt/texlive/texmf-local
TEXMFSYSCONFIG /opt/texlive/2025/texmf-config
TEXMFSYSVAR /opt/texlive/2025/texmf-var
TEXMFCONFIG /opt/texlive/2025/texmf-config
TEXMFVAR /opt/texlive/2025/texmf-var
TEXMFHOME /opt/texlive/texmf-local
instopt_adjustpath 0
instopt_adjustrepo 0
instopt_letter 0
instopt_portable 1
instopt_write18_restricted 0
tlpdbopt_autobackup 0
tlpdbopt_create_formats 1
tlpdbopt_generate_updmap 1
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0
